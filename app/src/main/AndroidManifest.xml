<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
         Dos permisos para lo mismo, y hacen falta los dos.

         Desde Android 13, SCHEDULE_EXACT_ALARM nace denegado y hay que ir a
         ajustes a concederlo a mano; sin él las alarmas se agrupan para ahorrar
         batería y un recordatorio de las 8:00 puede llegar a las 8:40. Con
         USE_EXACT_ALARM el sistema lo concede solo, que es lo correcto aquí
         porque la hora la fija el usuario y sin ella el aviso no sirve.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sesiones de enfoque: la cuenta atrás vive en un servicio en primer plano
         para que Android no la mate al cambiar de app o apagar la pantalla. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Activar "No molestar" durante la sesión. Se concede a mano desde Ajustes;
         si no se concede, la app funciona igual. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Habitos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Habitos"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarmas de recordatorio y acción "Marcar como hecho" -->
        <receiver
            android:name=".ReceptorRecordatorio"
            android:enabled="true"
            android:exported="false" />

        <!-- Vuelve a poner las alarmas después de reiniciar el teléfono -->
        <receiver
            android:name=".ReceptorArranque"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Widget de pantalla de inicio -->
        <receiver
            android:name=".WidgetHabitos"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            Pantalla de la sesión de enfoque.

            - showWhenLocked/turnScreenOn: aparece sobre la pantalla de bloqueo,
              igual que hace un despertador.
            - singleTask: una sola instancia, para que volver desde la
              notificación no apile pantallas encima.
            - lockTaskMode="if_whitelisted": si algún día el teléfono se
              aprovisiona como device owner, esta actividad ya queda autorizada
              para el bloqueo total sin tocar nada más.
        -->
        <activity
            android:name=".PantallaEnfoque"
            android:exported="false"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!--
            Android 14 exige declarar para qué sirve un servicio en primer plano.
            No hay tipo "temporizador", así que el correcto es specialUse con su
            justificación; es lo que usan las apps de pomodoro y concentración.
        -->
        <service
            android:name=".ServicioEnfoque"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cuenta atrás de una sesión de enfoque iniciada por el usuario, que debe seguir corriendo con la pantalla apagada." />
        </service>

    </application>

</manifest>
