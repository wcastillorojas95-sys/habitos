<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Entrar con Google habla con los servidores de Google. Todo lo demás de
         la app sigue siendo local: los hábitos no salen del teléfono. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
         Dos permisos para lo mismo, y hacen falta los dos.

         Desde Android 13, SCHEDULE_EXACT_ALARM nace denegado y hay que ir a
         ajustes a concederlo a mano; sin él las alarmas se agrupan para ahorrar
         batería y un recordatorio de las 8:00 puede llegar a las 8:40. Con
         USE_EXACT_ALARM el sistema lo concede solo, que es lo correcto aquí
         porque la hora la fija el usuario y sin ella el aviso no sirve.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- La alarma de la hora en punto toma la pantalla entera, como un
         despertador. Desde Android 14 hay que pedirlo; si no se concede, el
         aviso se degrada a notificación normal en vez de fallar. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Bloquear otras apps durante una sesión.

        Desde Android 10 una app no puede abrir una pantalla desde segundo plano
        salvo que tenga concedido "mostrar sobre otras aplicaciones". Es lo que
        permite que la pantalla de bloqueo aparezca encima de Instagram en vez de
        quedarse esperando a que abras Hábitos. Se concede a mano; sin ella la
        función se queda apagada en vez de fallar a medias.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Sesiones de enfoque: la cuenta atrás vive en un servicio en primer plano
         para que Android no la mate al cambiar de app o apagar la pantalla. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Activar "No molestar" durante la sesión. Se concede a mano desde Ajustes;
         si no se concede, la app funciona igual. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
        Desde Android 11 una app no ve qué otras apps hay instaladas salvo que
        declare qué busca. Solo necesitamos resolver los ajustes del sistema,
        para no bloquearlos nunca: son la salida de emergencia del bloqueo.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Habitos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Habitos"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarmas de recordatorio y acción "Marcar como hecho" -->
        <receiver
            android:name=".ReceptorRecordatorio"
            android:enabled="true"
            android:exported="false" />

        <!-- Vuelve a poner las alarmas después de reiniciar el teléfono -->
        <receiver
            android:name=".ReceptorArranque"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Widget de pantalla de inicio -->
        <receiver
            android:name=".WidgetHabitos"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            La alarma de una actividad.

            excludeFromRecents: no tiene sentido que quede en la lista de apps
            recientes; ya cumplió su función cuando la atendiste.
        -->
        <activity
            android:name=".PantallaAlarma"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@style/Theme.Habitos" />

        <!--
            La pantalla que tapa el resto de apps durante una sesión.

            taskAffinity vacío y excludeFromRecents: vive en su propia tarea y no
            aparece en recientes, así que no se puede volver a ella —ni salir de
            ella— por la lista de apps abiertas.

            singleTask: una sola instancia. El servicio la lanza cada vez que
            detecta una app bloqueada; sin esto se apilarían decenas de copias.
        -->
        <activity
            android:name=".PantallaBloqueo"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Habitos" />

        <activity
            android:name=".PantallaEnfoque"
            android:exported="false"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!--
            Android 14 exige declarar para qué sirve un servicio en primer plano.
            No hay tipo "temporizador", así que el correcto es specialUse con su
            justificación; es lo que usan las apps de pomodoro y concentración.
        -->
        <service
            android:name=".ServicioEnfoque"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cuenta atrás de una sesión de enfoque iniciada por el usuario, que debe seguir corriendo con la pantalla apagada." />
        </service>

        <!--
            Servicio de accesibilidad que detecta qué app está en primer plano.

            exported="true" y el permiso BIND_ACCESSIBILITY_SERVICE los exige
            Android: es el sistema quien se conecta a él, y el permiso garantiza
            que nadie más pueda hacerlo. El usuario tiene que activarlo a mano en
            Ajustes de Android; hasta entonces no se ejecuta nunca.
        -->
        <service
            android:name=".ServicioBloqueo"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/servicio_bloqueo" />
        </service>

    </application>

</manifest>
